pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        JAVA_HOME = '/opt/java/openjdk'
        MAVEN_HOME = '/usr/share/maven'
        PATH = "/opt/java/openjdk/bin:/usr/share/maven/bin:/usr/bin:/bin:/usr/local/bin"

        SONAR_PROJECT_KEY  = 'UserService_Dev'
        SONAR_PROJECT_NAME = 'UserService_Dev'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Trigger Info') {
            steps {
                echo "Build triggered by: ${currentBuild.getBuildCauses()}"
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                    echo "===== WORKSPACE DEBUG ====="
                    pwd
                    ls -la
                    find . -name pom.xml
                '''
            }
        }

        stage('Build & Test (with Coverage)') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        echo "===== BUILD + TEST ====="

                        mvn clean verify \
                        -Deureka.client.enabled=false \
                        -Dspring.cloud.discovery.enabled=false
                    '''
                }
            }
        }

        stage('Check JaCoCo Report') {
            steps {
                sh '''
                    echo "===== CHECKING JACOCO ====="
                    ls -la target/site/jacoco || echo "JaCoCo report not found"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarscanner') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            echo "===== SONAR ANALYSIS ====="

                            mvn sonar:sonar \
                              -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                              -Dsonar.projectName=$SONAR_PROJECT_NAME \
                              -Dsonar.login=$SONAR_TOKEN \
                              -Dsonar.java.binaries=target/classes \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                sh 'echo "===== RUNNING OWASP DEPENDENCY CHECK ====="'

                dependencyCheck(
                    odcInstallation: 'Default',
                    additionalArguments: '--format CSV --out . --disableOssIndex'
                )
            }
        }

        stage('Publish Reports') {
            steps {
                archiveArtifacts(
                    artifacts: 'dependency-check-report.csv',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    allowEmptyResults: true,
                    testResults: '**/target/surefire-reports/*.xml'
                )
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Build + Tests + SonarQube + OWASP completed successfully.'
        }

        unstable {
            echo 'UNSTABLE: Tests failed or Quality Gate did not pass.'
        }

        failure {
            echo 'FAILED: Check the Jenkins console logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
